#!/bin/sh
# Verify that `oo touch --relaunch-daemon` replaces the daemon process while
# keeping the same subnet octet.

NS="rl"

cleanup() { "$BIN" $FLAGS down "$NS" || true; }
"$BIN" $FLAGS down "$NS" || true
trap cleanup EXIT

"$BIN" $FLAGS up -d "$NS" -- sleep 30
OLD_PID=$(grep '^daemon_pid=' "/var/run/oo/$NS/pids.ini" | cut -d= -f2)
OLD_OCTET=$(grep '^subnet_octet=' "/var/run/oo/$NS/network.ini" | cut -d= -f2)

"$BIN" $FLAGS touch -d "$NS" --relaunch-daemon -- sleep 30
sleep 1
NEW_PID=$(grep '^daemon_pid=' "/var/run/oo/$NS/pids.ini" | cut -d= -f2)
NEW_OCTET=$(grep '^subnet_octet=' "/var/run/oo/$NS/network.ini" | cut -d= -f2)

if [ -n "$NEW_PID" ] && [ "$NEW_PID" != "$OLD_PID" ]; then
  echo "relaunch changed daemon pid (ok)"
else
  echo "relaunch changed daemon pid (FAILED old=$OLD_PID new=$NEW_PID)"
fi
if kill -0 "$NEW_PID" 2>/dev/null; then
  echo "new daemon alive (ok)"
else
  echo "new daemon alive (FAILED)"
fi
if [ -n "$NEW_OCTET" ] && [ "$NEW_OCTET" = "$OLD_OCTET" ]; then
  echo "subnet preserved (ok)"
else
  echo "subnet preserved (FAILED old=$OLD_OCTET new=$NEW_OCTET)"
fi
