#!/bin/sh
# Verify that a subnet freed on down is reusable. The lowest free octet is
# allocated, so bringing one namespace up and down then another up should reuse
# the same octet, proving free() actually released it.

NS1="pf1"
NS2="pf2"

cleanup() {
  "$BIN" $FLAGS down "$NS1" || true
  "$BIN" $FLAGS down "$NS2" || true
}
"$BIN" $FLAGS down "$NS1" || true
"$BIN" $FLAGS down "$NS2" || true
trap cleanup EXIT

"$BIN" $FLAGS up "$NS1" -- sleep 3
OCT1=$(grep '^subnet_octet=' "/var/run/oo/$NS1/network.ini" | cut -d= -f2)
"$BIN" $FLAGS down "$NS1"

"$BIN" $FLAGS up "$NS2" -- sleep 3
OCT2=$(grep '^subnet_octet=' "/var/run/oo/$NS2/network.ini" | cut -d= -f2)

if test -n "$OCT1" && test "$OCT1" = "$OCT2"; then
  echo "freed subnet reused (ok)"
else
  echo "freed subnet oct1=$OCT1 oct2=$OCT2 (FAILED)"
fi
