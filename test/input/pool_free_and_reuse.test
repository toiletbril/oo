#!/bin/sh
# Verify that down frees the namespace's pool entry and that the name can be
# brought up again afterward, which proves free() released the slot. A specific
# octet cannot be asserted because the suite runs tests in parallel and they
# share the pool.

NS="pf"
POOL="/var/run/oo/ip-pool.ini"

cleanup() { "$BIN" $FLAGS down "$NS" || true; }
"$BIN" $FLAGS down "$NS" || true
trap cleanup EXIT

"$BIN" $FLAGS up "$NS" -- sleep 3
"$BIN" $FLAGS down "$NS"

if grep -q "=${NS}\$" "$POOL"; then
  echo "pool entry freed on down: FAILED"
else
  echo "pool entry freed on down: ok"
fi

"$BIN" $FLAGS up "$NS" -- sleep 3

if grep -q "=${NS}\$" "$POOL"; then
  echo "pool entry reallocated on re-up: ok"
else
  echo "pool entry reallocated on re-up: FAILED"
fi
